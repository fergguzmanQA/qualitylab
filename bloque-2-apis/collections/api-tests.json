{
	"info": {
		"name": "Suite de Pruebas API - MVP",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Validar Obtención de Usuarios",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code es 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('La respuesta contiene datos válidos', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://jsonplaceholder.typicode.com/users",
					"protocol": "https",
					"host": [
						"jsonplaceholder",
						"typicode",
						"com"
					],
					"path": [
						"users"
					]
				},
				"description": "Prueba MVP para validar el correcto funcionamiento del endpoint de usuarios."
			},
			"response": []
		}
	]
}
